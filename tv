#!/bin/sh
# tv: Terminal Values' box, from the member's own computer.
#
# The TV folder is an ordinary folder here; the box (one container) mounts
# it and does the syncing, the git, the secrets and TV's tools, so nothing
# TV-specific is installed on this computer. tv works with Apple's
# container, Docker or Podman, whichever is here. `tv help` lists commands.
set -u

BOX=tvbox
VOLUME=tv-state
INSIDE=/home/tv/terminalvalues
INNER_PORT=8484  # TV's pages, inside the box
REGISTRY=ghcr.io/terminal-values/tvbox
DEFAULT_IMAGE=$REGISTRY:latest
GITHUB=https://api.github.com/repos/terminal-values/tvbox
CONFIG=${TV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tv/config}

FOLDER= IMAGE= LOGIN= NAME= EMAIL= RUNTIME= REVISION= TAILNET= TVHOME_ID= PORT=
# shellcheck disable=SC1090
[ -r "$CONFIG" ] && . "$CONFIG"
IMAGE=${IMAGE:-$DEFAULT_IMAGE}
# The pages' port on this computer: 8484, or the next free one.
PORT=${PORT:-$INNER_PORT}

say() { printf '%s\n' "$*"; }
# How to run tv again: plain tv if the shell finds it, else its full path
# (straight after installing, ~/.local/bin isn't on the PATH yet).
me() { if command -v tv >/dev/null 2>&1; then echo tv; else echo "$HOME/.local/bin/tv"; fi; }
die() { code=$1; shift; printf '%s\n' "$*" >&2; exit "$code"; }

# --- the runtime -----------------------------------------------------------

detect_runtime() {
    RT=${TV_RUNTIME:-$RUNTIME}
    if [ -n "$RT" ] && command -v "$RT" >/dev/null 2>&1; then :; else
        RT=
        for r in container docker podman; do
            if command -v "$r" >/dev/null 2>&1; then RT=$r; break; fi
        done
    fi
}

find_runtime() {
    detect_runtime
    [ -n "$RT" ] || die 4 "No container runtime found. Install one first: on a Mac,
Apple's container (https://github.com/apple/container/releases); on Linux,
sudo apt install podman."
    # Rootless Podman's root is already you; elsewhere the box runs as you.
    if [ "$RT" = podman ]; then UID_IN=0 GID_IN=0
    else UID_IN=$(id -u) GID_IN=$(id -g); fi
}

runtime_answers() {
    case $RT in
        container) container system status >/dev/null 2>&1 ;;
        *) "$RT" info >/dev/null 2>&1 ;;
    esac
}

runtime_up() {
    find_runtime
    case $RT in
        container) container system status >/dev/null 2>&1 ||
            die 4 "Apple's container service isn't running. Start it with: container system start" ;;
        docker) docker info >/dev/null 2>&1 ||
            die 4 "Docker isn't running. Open Docker Desktop (or start colima), then try again." ;;
        podman) podman info >/dev/null 2>&1 ||
            die 4 "Podman isn't answering. On a Mac, start it with: podman machine start" ;;
    esac
}

# running, stopped or absent
box_state() {
    case $RT in
        container)
            out=$(container inspect "$BOX" 2>/dev/null) || { say absent; return; }
            case $out in *'"running"'*) say running ;; *) say stopped ;; esac ;;
        *)
            out=$("$RT" inspect -f '{{.State.Running}}' "$BOX" 2>/dev/null) || { say absent; return; }
            [ "$out" = true ] && say running || say stopped ;;
    esac
}

need_config() {
    [ -n "$FOLDER" ] && [ -n "$LOGIN" ] || die 2 "This computer hasn't joined TV yet: run tv join first."
}

# Is something on this computer listening on 127.0.0.1:PORT? (Another
# user's box on the same Mac, say.) Without nc or bash, assume not.
port_busy() {
    if command -v nc >/dev/null 2>&1; then nc -z 127.0.0.1 "$1" >/dev/null 2>&1
    elif command -v bash >/dev/null 2>&1; then bash -c "echo > /dev/tcp/127.0.0.1/$1" 2>/dev/null
    else return 1; fi
}

# Make the box, on a free port. Returns non-zero if the runtime won't.
create_box() {
    need_config
    i=0
    while port_busy "$PORT" && [ $i -lt 50 ]; do PORT=$((PORT + 1)); i=$((i + 1)); done
    [ -r "$CONFIG" ] && write_config
    if [ "$RT" = container ]; then
        container volume inspect "$VOLUME" >/dev/null 2>&1 ||
            container volume create "$VOLUME" >/dev/null
    fi
    "$RT" run -d --name "$BOX" \
        -v "$FOLDER:$INSIDE" -v "$VOLUME:/state" \
        -p "127.0.0.1:$PORT:$INNER_PORT" \
        -e "TV_UID=$UID_IN" -e "TV_GID=$GID_IN" -e "TV_LOGIN=$LOGIN" \
        -e "TV_NAME=$NAME" -e "TV_EMAIL=$EMAIL" \
        -e "TVHOME_HOST=tvhome.$TAILNET" -e "TVHOME_SYNCTHING_ID=$TVHOME_ID" \
        "$IMAGE" >/dev/null
}

need_box() {
    runtime_up
    [ "$(box_state)" = running ] || die 3 "The box isn't running. Start it with: tv start"
}

# Run a command in the box, in the TV folder, as you.
in_box() {
    if [ -t 0 ] && [ -t 1 ]; then tty=-t; else tty=; fi
    # shellcheck disable=SC2086
    "$RT" exec -i $tty -u "$UID_IN:$GID_IN" -w "$INSIDE" "$BOX" "$@"
}

# --- config ----------------------------------------------------------------

# Where the TV folder goes unless tv join --folder says otherwise: in
# Documents, not one more thing at the top of the home folder. But not in a
# Mac's Documents that iCloud syncs: TV's documents would go to Apple, and two
# sync programs would fight over the same files. Sets folder and why.
default_folder() {
    why=
    if [ "$(uname)" = Darwin ]; then
        if [ "$(defaults read com.apple.finder FXICloudDriveDocuments 2>/dev/null)" = 1 ]; then
            folder=$HOME/terminalvalues
            why="(Not in Documents, because iCloud syncs that, and TV's documents travel only by tvhome.)"
        else
            folder=$HOME/Documents/terminalvalues
        fi
        return
    fi
    docs=$(xdg-user-dir DOCUMENTS 2>/dev/null) || docs=
    [ -n "$docs" ] && [ "$docs" != "$HOME" ] && [ -d "$docs" ] || docs=$HOME/Documents
    if [ -d "$docs" ]; then folder=$docs/terminalvalues; else folder=$HOME/terminalvalues; fi
}

quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# json_str STRING: STRING as a JSON string literal, for the Mac app's --json
# output (backslashes, quotes and control characters escaped).
json_str() {
    printf '%s' "$1" | awk 'BEGIN { ORS = ""; print "\"" }
        NR > 1 { print "\\n" }
        { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "\\r")
          gsub(/[\001-\037]/, ""); print }
        END { print "\"" }'
}

write_config() {
    mkdir -p "$(dirname "$CONFIG")"
    {
        say "# tv's settings for this computer; tv join writes them."
        say "FOLDER=$(quote "$FOLDER")"
        say "IMAGE=$(quote "$IMAGE")"
        say "LOGIN=$(quote "$LOGIN")"
        say "NAME=$(quote "$NAME")"
        say "EMAIL=$(quote "$EMAIL")"
        say "RUNTIME=$(quote "$RT")"
        say "REVISION=$(quote "$REVISION")"
        say "TAILNET=$(quote "$TAILNET")"
        say "TVHOME_ID=$(quote "$TVHOME_ID")"
        say "PORT=$(quote "$PORT")"
    } > "$CONFIG.tmp" && mv -f "$CONFIG.tmp" "$CONFIG"
}

# --- versions --------------------------------------------------------------
# The box runs with the age key and the secrets, so a new image is trusted
# like new code: it's pinned by digest, and tv update shows what changed
# (tvbox's commits since this one) and asks first. GitHub's JSON is read
# with sed, since a fresh Mac may have no usable Python.

latest_revision() {
    curl -fsSL "$GITHUB/commits/main" 2>/dev/null |
        sed -n 's/^  "sha": "\([0-9a-f]*\)".*/\1/p' | head -1
}

image_digest() {  # image_digest REVISION
    token=$(curl -fsSL "https://ghcr.io/token?scope=repository:terminal-values/tvbox:pull" 2>/dev/null |
        sed -n 's/.*"token": *"\([^"]*\)".*/\1/p')
    rev7=$(printf '%s' "$1" | head -c 7)
    curl -fsSI -H "Authorization: Bearer $token" \
        -H "Accept: application/vnd.oci.image.index.v1+json" \
        "https://ghcr.io/v2/terminal-values/tvbox/manifests/sha-$rev7" 2>/dev/null |
        tr -d '\r' | sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: *//p'
}

changes() {  # changes FROM TO: one line per commit, its subject
    # Only the "commits" list: the reply also gives the starting commit, twice.
    curl -fsSL "$GITHUB/compare/$1...$2" 2>/dev/null |
        sed -n '/^  "commits": \[/,$ s/^ *"message": "\([^"\\]*\).*/  \1/p'
}

# The last few commits on main, newest first (each commit's own "sha" is
# the one indented four spaces; its tree's and parents' are deeper).
recent_revisions() {
    curl -fsSL "$GITHUB/commits?sha=main&per_page=5" 2>/dev/null |
        sed -n 's/^    "sha": "\([0-9a-f]*\)".*/\1/p'
}

# Pin the newest published image, if GitHub and the registry answer. That's
# the newest commit's, or an earlier one's while its build is still running.
pin_latest() {
    command -v curl >/dev/null 2>&1 || return 1
    for rev in $(recent_revisions); do
        digest=$(image_digest "$rev")
        if [ -n "$digest" ]; then IMAGE=$REGISTRY@$digest REVISION=$rev; return 0; fi
    done
    return 1
}

# --- commands --------------------------------------------------------------

# parse_invitation TEXT: sets tailnet, tvhome_id and key; fails if TEXT
# isn't a whole invitation (tvjoin:TAILNET:TVHOME-SYNCTHING-ID:tskey-...).
parse_invitation() {
    old_ifs=$IFS; IFS=:
    # shellcheck disable=SC2086
    set -- $1
    IFS=$old_ifs
    [ $# -eq 4 ] && [ "$1" = tvjoin ] || return 1
    # Each part has its own shape, checked strictly: they end up in a file
    # the box reads as shell.
    printf '%s' "$2" | grep -Eqx '[a-z0-9-]+(\.[a-z0-9-]+)+' || return 1
    printf '%s' "$3" | grep -Eqx '([A-Z2-7]{7}-){7}[A-Z2-7]{7}' || return 1
    printf '%s' "$4" | grep -Eqx 'tskey-[A-Za-z0-9-]+' || return 1
    tailnet=$2 tvhome_id=$3 key=$4
}

# Wait until the clipboard holds an invitation, so the member copies it from
# Signal and never pastes it (or sees the key) in the terminal.
invitation_from_clipboard() {
    say "Now copy the invitation Danny sent you: the whole line, starting tvjoin:,"
    say "from Signal (or wherever he sent it). I'll notice it on the clipboard."
    # At a terminal, wait for as long as it takes; otherwise (the Mac app,
    # which asks for the copy first) a minute, rather than hang.
    if [ -t 0 ]; then say "(Ctrl-C to stop.)"; tries=-1; else tries=60; fi
    while :; do
        invite=$(pbpaste 2>/dev/null)
        parse_invitation "$invite" && break
        [ "$tries" -eq 0 ] && die 2 "There's no invitation on the clipboard: copy the whole line Danny sent, starting tvjoin:, and try again."
        tries=$((tries - 1))
        sleep "${TV_POLL:-1}"
    done
    say "Got it."
}

cmd_join() {
    login= folder= adopt=no name=$NAME email=$EMAIL clip=no
    while [ $# -gt 0 ]; do
        case $1 in
            --login) login=${2:-}; shift ;;
            --name) name=${2:-}; shift ;;
            --email) email=${2:-}; shift ;;
            --folder) folder=${2:-}; shift ;;
            --adopt) adopt=yes ;;
            --from-clipboard) clip=yes ;;
            *) die 2 "tv join: unknown option $1" ;;
        esac
        shift
    done
    # The runtime first, so nobody answers questions only to be told to
    # install it. At a terminal, offer to start one that isn't running.
    find_runtime
    if ! runtime_answers && [ -t 0 ]; then
        printf 'The container runtime (%s) isn'"'"'t running. Start it now? [Y/n] ' "$RT"
        read -r answer || true
        case $answer in [nN]*) ;; *) cmd_runtime_start ;; esac
    fi
    runtime_up
    if [ -z "$login" ]; then
        printf 'The login name you picked: '
        read -r login || [ -n "$login" ] || die 2 "No login name given."
    fi
    printf '%s\n' "$login" | grep -Eq '^[a-z][a-z0-9-]{0,31}$' ||
        die 2 "'$login' won't do as a login: short, lowercase letters, digits and dashes, starting with a letter."
    # For the history: who made each commit.
    if [ -z "$name" ] && [ -t 0 ]; then printf 'Your name, as it should appear in TV'"'"'s history: '; read -r name || true; fi
    if [ -z "$email" ] && [ -t 0 ]; then printf 'Your email: '; read -r email || true; fi
    why=
    # Joining again (a new invitation) keeps the folder this computer has.
    [ -n "$folder" ] || folder=$FOLDER
    [ -n "$folder" ] || default_folder
    # A folder holding only Syncthing's markers is one an earlier join made,
    # and the one in the config is TV's whatever it holds.
    if [ -d "$folder" ] && [ -n "$(ls -A "$folder" | grep -vxE '\.stfolder|\.stignore|\.DS_Store')" ] &&
       [ ! -e "$folder/.git" ] && [ "$folder" != "$FOLDER" ] &&
       [ "$adopt" = no ]; then
        die 2 "$folder already has files in it, and isn't a TV folder. Pick another
with --folder, or use it anyway with: tv join --adopt --folder $folder"
    fi
    # The invitation Danny sends: tvjoin:TAILNET:TVHOME-SYNCTHING-ID:KEY.
    # It's the only place the box learns where TV's tailnet is, and the key
    # in it goes to the box and nowhere else. At a terminal on a Mac, tv
    # watches the clipboard for it; otherwise it's read, unseen, from input.
    if [ "$clip" = yes ] || { [ -t 0 ] && command -v pbpaste >/dev/null 2>&1; }; then
        invitation_from_clipboard
    elif [ -t 0 ]; then
        printf 'The invitation Danny sent you (it starts tvjoin:; it won'"'"'t show): '
        stty -echo 2>/dev/null; read -r invite; stty echo 2>/dev/null; echo
    else
        read -r invite || true  # keep a last line with no newline (pbpaste)
    fi
    parse_invitation "$invite" ||
        die 2 "That isn't a whole invitation: it's one line, starting tvjoin:, as Danny sent it."

    runtime_up
    mkdir -p "$folder" || die 1 "Couldn't make $folder."
    FOLDER=$(cd "$folder" && pwd) LOGIN=$login TAILNET=$tailnet TVHOME_ID=$tvhome_id
    NAME=$name EMAIL=$email
    [ "$IMAGE" = "$DEFAULT_IMAGE" ] && pin_latest
    # A box made before this join may know another tailnet: make it afresh
    # (its storage, and so any age key, is kept).
    if [ "$(box_state)" != absent ]; then
        "$RT" stop "$BOX" >/dev/null 2>&1
        "$RT" rm "$BOX" >/dev/null 2>&1
    fi
    again="Once that's sorted out, run $(me) join again."
    create_box || die 1 "The box wouldn't start (see above). $again"
    printf '%s\n' "$key" | in_box tvbox-join "$LOGIN" || die $? "$again"
    # Only now: a config is what tells tv (and the installer) this computer
    # has joined.
    write_config
    say "Your TV folder is $FOLDER.${why:+ $why}"
    say "(tv folder says where it is; tv move puts it somewhere else.)"
    # The invitation's key is used up now, but don't leave it lying about.
    if [ "$clip" = yes ] || command -v pbcopy >/dev/null 2>&1; then
        printf '' | pbcopy 2>/dev/null
    fi
}

cmd_start() {
    runtime_up
    case $(box_state) in
        running) say "The box is already running." ; return ;;
        stopped)
            if port_busy "$PORT"; then
                # Something else took its port while it was stopped: remake it
                # on another (its storage, and so the key, is kept).
                "$RT" rm "$BOX" >/dev/null 2>&1
                create_box || die 1 "The box wouldn't start (see above)."
                say "Its usual port was taken, so TV's pages are now at http://127.0.0.1:$PORT/ (tv pages opens them)."
            else
                "$RT" start "$BOX" >/dev/null || die 1 "The box wouldn't start (see above)."
            fi ;;
        absent) create_box || die 1 "The box wouldn't start (see above)." ;;
    esac
    say "The box is running; TV's documents sync while it runs. tv stop stops it."
}

cmd_stop() {
    runtime_up
    [ "$(box_state)" = running ] && "$RT" stop "$BOX" >/dev/null
    say "The box is stopped: documents won't sync until you run tv start."
}

cmd_status() {
    [ "${1:-}" = --json ] && { status_json; return; }
    runtime_up
    if [ "$(box_state)" != running ]; then
        say "The box is not running, so your changes are not syncing. Start it with: tv start"
        exit 3
    fi
    in_box tvbox-status
}

# tv pages [PATH]: TV's internal pages, or one of them (a path in www/).
# tv status --json: what the Mac app shows. Exit 0 whenever it could tell,
# even with no runtime; the box's own half (tailnet, sync) only if it runs.
status_json() {
    detect_runtime
    [ -n "$RT" ] && find_runtime  # which also says whose uid the box runs as
    rt=${RT:-none} up=false box=absent inside='{"tailnet": null, "sync": null}'
    if [ -n "$RT" ] && runtime_answers; then
        up=true box=$(box_state)
        if [ "$box" = running ]; then
            inside=$(in_box tvbox-status --json 2>/dev/null) || inside='{"tailnet": null, "sync": null}'
        fi
    fi
    printf '{"box": %s, "runtime": %s, "runtime_running": %s, "login": %s, "name": %s, "folder": %s, "port": %s, ' \
        "$(json_str "$box")" "$(json_str "$rt")" "$up" "$(json_str "$LOGIN")" "$(json_str "$NAME")" \
        "$(json_str "$FOLDER")" "${PORT:-0}"
    # The box's object, without its braces, completes this one.
    printf '%s\n' "$inside" | tr -d '\n' | sed 's/^[[:space:]]*{//; s/}[[:space:]]*$//'
    printf '}\n'
}

cmd_pages() {
    need_box
    url=http://127.0.0.1:$PORT/$(printf '%s' "${1:-}" | sed 's:^/*::; s/ /%20/g')
    if command -v open >/dev/null 2>&1; then open "$url"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url"
    else say "TV's pages: $url"; fi
}

# tv move NEW-FOLDER: put the TV folder somewhere else. The box mounts the
# folder when it's made, so it's remade (its storage, and so the key, is
# kept). Syncthing inside sees the same path as before, so nothing resyncs.
cmd_move() {
    need_config
    [ $# -eq 1 ] && [ -n "$1" ] || die 2 "Usage: tv move NEW-FOLDER"
    case $1 in /*) dest=$1 ;; *) dest=$(pwd)/$1 ;; esac
    dest=${dest%/}
    case $dest/ in "$FOLDER"/*) die 2 "$dest is in the TV folder itself; pick somewhere outside it." ;; esac
    if [ -e "$dest" ]; then
        [ -d "$dest" ] && [ -z "$(ls -A "$dest")" ] ||
            die 2 "$dest already has something in it; pick a new or empty folder."
    fi
    runtime_up
    was=$(box_state)
    [ "$was" = running ] && "$RT" stop "$BOX" >/dev/null
    [ -d "$dest" ] && rmdir "$dest"
    mkdir -p "$(dirname "$dest")" && mv "$FOLDER" "$dest" ||
        die 1 "Couldn't move $FOLDER to $dest."
    FOLDER=$dest
    write_config
    [ "$was" != absent ] && "$RT" rm "$BOX" >/dev/null 2>&1
    if [ "$was" = running ]; then
        create_box || die 1 "The folder moved, but the box wouldn't start (see above). Try tv start."
    fi
    say "The TV folder is now $FOLDER."
}

cmd_import_key() {
    need_box
    [ -t 0 ] && die 2 "Send the key file in: tv import-key < where-you-saved-it"
    in_box tvbox-import-key "$@"
}

# tv export-key [FILE]: a copy of your age key, to FILE (made readable only
# by you) or to wherever stdout goes, but never the screen.
cmd_export_key() {
    need_box
    if [ -n "${1:-}" ]; then
        [ -e "$1" ] && die 2 "$1 is already there; pick a new name."
        ( umask 077; in_box cat /state/home/.passage/identities > "$1" ) || die 1 "Couldn't write $1."
        say "Your age key is in $1, readable only by you. Put it somewhere safe (your"
        say "password manager), then delete it here."
        return
    fi
    [ -t 1 ] && die 2 "This writes out your secret key, so send it to a file, not the screen:
tv export-key > somewhere-safe/tv-age-key.txt"
    in_box cat /state/home/.passage/identities
}

# For the Mac app: where things stand, in one word.
cmd_check() {
    detect_runtime
    if [ -z "$RT" ]; then say no-runtime
    elif ! runtime_answers; then say runtime-stopped
    elif [ -z "$LOGIN" ] || [ -z "$FOLDER" ]; then say not-joined
    elif [ "$(box_state)" = running ]; then say running
    else say stopped; fi
}

cmd_runtime_start() {
    find_runtime
    case $RT in
        container) container system start --enable-kernel-install ;;
        docker) if [ "$(uname)" = Darwin ]; then open -a Docker; else die 1 "Start Docker with: sudo systemctl start docker"; fi ;;
        podman) podman machine start ;;
    esac
}

cmd_uninstall() {
    keep=ask
    [ "${1:-}" = --yes-keep-state ] && keep=yes
    detect_runtime
    # With the runtime stopped, the box and its storage can't be removed:
    # stop here rather than leave them behind and say they're gone.
    if [ -n "$RT" ] && ! runtime_answers; then
        die 4 "The container runtime ($RT) isn't running, so the box can't be removed. Start it, then run tv uninstall again."
    fi
    if [ -n "$RT" ]; then
        "$RT" stop "$BOX" >/dev/null 2>&1
        "$RT" rm "$BOX" >/dev/null 2>&1
        "$RT" image rm "$IMAGE" >/dev/null 2>&1
        say "Removed the box and its image."
        if [ "$keep" = ask ]; then
            say "The box's storage, $VOLUME, holds your age key, TV's secrets, and the box's"
            say "Tailscale and Syncthing settings. If you haven't saved your age key"
            say "elsewhere, answer n and run tv export-key first."
            printf 'Delete %s too? [y/N] ' "$VOLUME"
            read -r answer || true
            case $answer in
                [yY]*) "$RT" volume rm "$VOLUME" >/dev/null && say "Deleted $VOLUME." ;;
                *) say "Kept $VOLUME." ;;
            esac
        fi
    fi
    for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.profile"; do
        if [ -f "$rc" ] && grep -qF "# added by the tvbox installer" "$rc"; then
            # Rewritten in place, not replaced: it may be a symlink (stow).
            # (grep -v exits 1 when nothing's left: still a success here.)
            { grep -vF "# added by the tvbox installer" "$rc" || true; } > "$rc.tvbox-tmp" &&
                cat "$rc.tvbox-tmp" > "$rc"
            rm -f "$rc.tvbox-tmp"
            say "Took the PATH line out of $rc."
        fi
    done
    rm -rf "$HOME/Applications/Terminal Values.app"
    rm -f "$CONFIG" "$HOME/.local/bin/tv"
    say "tv is uninstalled.${FOLDER:+ The TV folder, $FOLDER, is still there.}"
}

cmd_update() {
    need_config
    runtime_up
    command -v curl >/dev/null 2>&1 || die 1 "tv update needs curl."
    new=$(latest_revision)
    [ -n "$new" ] || die 1 "Couldn't reach GitHub to check for a newer box."
    if [ "$new" = "$REVISION" ]; then
        say "The box is up to date."
        return
    fi
    digest=$(image_digest "$new")
    [ -n "$digest" ] || die 1 "There's a newer box, but its image isn't published yet. Try again later."
    say "There's a newer box. What changed:"
    if [ -n "$REVISION" ]; then changes "$REVISION" "$new"
    else say "  (this box's version wasn't recorded, so the changes can't be listed)"; fi
    printf 'Update to it? [y/N] '
    read -r answer || true
    case $answer in [yY]*) ;; *) say "Left as it was."; return ;; esac
    IMAGE=$REGISTRY@$digest REVISION=$new
    write_config
    if [ "$(box_state)" != absent ]; then
        "$RT" stop "$BOX" >/dev/null 2>&1
        "$RT" rm "$BOX" >/dev/null || die 1 "Couldn't remove the old box."
    fi
    create_box || die 1 "The new box wouldn't start (see above). Your folder, key and secrets are as they were."
    # tv updates itself too, from the same commit.
    if [ "$0" = "$HOME/.local/bin/tv" ] &&
       curl -fsSL "https://raw.githubusercontent.com/terminal-values/tvbox/$new/tv" -o "$0.new"; then
        chmod 755 "$0.new" && mv -f "$0.new" "$0"
    fi
    say "Updated. Your folder, key and secrets are as they were."
}

usage() {
    cat <<'EOF'
tv: Terminal Values' box.

  tv join          join TV from this computer (once)
  tv start         start the box; documents sync while it runs
  tv stop          stop it
  tv status        is it running, on the tailnet, syncing?
  tv catch-up      bring the code and secrets up to date, showing code changes first
  tv push          send your code commits and the secrets to tvhome
  tv git ...       git, in the TV folder, in the box
  tv passage ...   TV's shared secrets
  tv pages [PAGE]  open TV's internal pages (or one, by its path in www/)
  tv shell         a shell in the box, in the TV folder
  tv run CMD ...   run any command in the box, in the TV folder
  tv import-key    bring in your saved age key (tv import-key < file)
  tv export-key F  save a copy of your age key to file F
  tv update        get a newer box, showing what changed first
  tv folder        print where the TV folder is
  tv move FOLDER   move the TV folder somewhere else
  tv uninstall     remove the box and tv
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
    join) cmd_join "$@" ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    status) cmd_status "$@" ;;
    catch-up) need_box; in_box tvbox-catch-up ;;
    push) need_box; in_box tvbox-push ;;
    git|passage) need_box; in_box "$cmd" "$@" ;;
    run) need_box; in_box "$@" ;;
    shell) need_box; in_box bash -l ;;
    pages) cmd_pages "$@" ;;
    import-key) cmd_import_key "$@" ;;
    export-key) cmd_export_key "$@" ;;
    folder) need_config; say "$FOLDER" ;;
    move) cmd_move "$@" ;;
    check) cmd_check ;;
    runtime-start) cmd_runtime_start ;;
    update) cmd_update ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) usage ;;
    *)  # A near miss gets a suggestion: tv catchup, tv catch_up, tv Status.
        near=$(printf '%s' "$cmd" | tr 'A-Z_' 'a-z-')
        for c in join start stop status catch-up push git passage run shell pages \
                 import-key export-key folder move update uninstall; do
            [ "$(printf '%s' "$c" | tr -d -)" = "$(printf '%s' "$near" | tr -d -)" ] && near=$c && break
            c=
        done
        if [ -n "$c" ]; then die 2 "tv $cmd isn't a command. Did you mean tv $c?"
        else die 2 "tv $cmd isn't a command. tv help lists them."; fi ;;
esac
