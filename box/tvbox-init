#!/bin/sh
# The box's first process. It starts as root only to hand /state to the
# member's uid (TV_UID, TV_GID, from tv; 0 under rootless Podman, whose
# root is the member), then runs everything as them:
#   - tailscaled, in userspace mode with a SOCKS5 proxy on 127.0.0.1:1055,
#     so the box needs no network device and nothing on the computer changes;
#   - Syncthing, syncing the TV folder with tvhome only, through that proxy;
#   - tvbox-pages, which hands the computer's 127.0.0.1:8484 to tvhome's pages.
# The box runs only while the member wants it; nothing restarts it.
set -u
U=${TV_UID:-0} G=${TV_GID:-0}
# Where tvhome is comes from tv (the member's invitation), never the image.
[ -n "${TVHOME_HOST:-}" ] || { echo "tvbox-init: TVHOME_HOST isn't set; start the box with tv" >&2; exit 1; }
INSIDE=/home/tv/terminalvalues
ST=/state/syncthing

# ssh refuses to run as a uid with no passwd entry, and the member's uid
# (from their computer) is unknown to the image.
getent group "$G" >/dev/null || echo "tv:x:$G:" >> /etc/group
getent passwd "$U" >/dev/null ||
    echo "tv:x:$U:$G:${TV_NAME:-Terminal Values member}:$HOME:/bin/bash" >> /etc/passwd

mkdir -p "$HOME" /state/tailscale "$ST" /var/run/tailscale
chown "$U:$G" /state /state/home /state/tailscale "$ST" /var/run/tailscale
# For the scripts tv runs in the box, which may not see this environment.
printf 'TVHOME_HOST=%s\nTVHOME_SYNCTHING_ID=%s\nTV_LOGIN=%s\n' \
    "$TVHOME_HOST" "${TVHOME_SYNCTHING_ID:-}" "${TV_LOGIN:-}" > /state/tvhome.env
as_member() {
    if [ "$U" = 0 ]; then "$@"
    else setpriv --reuid="$U" --regid="$G" --clear-groups "$@"; fi
}

# Restart a daemon if it dies, for as long as the box runs.
loops=
keep() { ( while :; do as_member "$@"; sleep 2; done ) & loops="$loops $!"; }

# When the box is stopped, stop the daemons properly: otherwise tvhome is
# left holding a dead Syncthing connection and turns the box away for minutes
# when it comes back.
stop() {
    # shellcheck disable=SC2086
    kill $loops 2>/dev/null
    pkill -TERM -f 'syncthing serve'; pkill -TERM socat
    i=0
    while pgrep -f 'syncthing serve' >/dev/null && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
    pkill -TERM tailscaled
    exit 0
}
trap stop TERM INT

keep tailscaled --tun=userspace-networking --socks5-server=127.0.0.1:1055 \
    --statedir=/state/tailscale --socket=/var/run/tailscale/tailscaled.sock

[ -s "$ST/config.xml" ] || as_member syncthing generate --home="$ST" --no-default-folder >/dev/null
all_proxy=socks5://127.0.0.1:1055 keep syncthing serve --home="$ST" --no-browser \
    --gui-address=127.0.0.1:8384 --no-restart --no-upgrade
as_member tvbox-configure &

keep tvbox-pages

wait
