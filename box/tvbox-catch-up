#!/bin/sh
# tv catch-up. The first time, gives the TV folder its git history (the
# documents are already there by Syncthing) and fetches the secrets store;
# then hands over to the folder's own bin/tv-catch-up, which shows code
# changes before applying them.
set -eu
. /state/tvhome.env
INSIDE=/home/tv/terminalvalues
# No apostrophes in this message: dash reads them as quotes, even here.
login=${TV_LOGIN:?the box has no login yet, so run tv join}
cd "$INSIDE"
if [ ! -e .git ]; then
    echo "Fetching TV's history and code from tvhome..."
    tmp=$(mktemp -d /state/tv-git.XXXXXX)
    git clone -q --no-checkout -o tvhome "$login@$TVHOME_HOST:/srv/git/terminalvalues.git" "$tmp"
    mv "$tmp/.git" . && rm -rf "$tmp"
    git reset -q tvhome/main
    git checkout -- . ':!doc' ':!www' ':!ledger' ':!entity' ':!site'
fi
if [ ! -e "$PASSAGE_DIR/.git" ]; then
    echo "Fetching TV's secrets from tvhome..."
    git clone -q -o tvhome "$login@$TVHOME_HOST:/srv/git/terminalvalues-secrets.git" "$PASSAGE_DIR"
fi
exec bin/tv-catch-up
