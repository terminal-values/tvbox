#!/bin/sh
# tvbox-join LOGIN, with the auth key Danny sent on stdin: put the box on
# TV's tailnet, make the member's age key, and print what Danny needs.
# Safe to run again: a failed login leaves nothing behind, and an existing
# age key is kept.
set -u
login=${1:?usage: tvbox-join LOGIN}
read -r key || true  # keep a last line with no newline
[ -n "$key" ] || { echo "tvbox-join: no auth key given (it starts tskey-)" >&2; exit 2; }

# tv runs this straight after starting the box: wait for its settings and
# for tailscaled, so a slow start isn't taken for a bad key.
i=0
until [ -s /state/tvhome.env ] && tailscale status --json >/dev/null 2>&1; do
    i=$((i + 1)); [ $i -gt 60 ] && { echo "tvbox-join: the box didn't finish starting" >&2; exit 1; }
    sleep 1
done
. /state/tvhome.env

# The key goes to tailscale in a file, not its arguments, which other users
# can see while it runs; the file is gone however this ends.
keyfile=$(mktemp /state/.authkey.XXXXXX)
trap 'rm -f "$keyfile"' EXIT
printf '%s\n' "$key" > "$keyfile"
if ! tailscale up --auth-key="file:$keyfile" --hostname="tv-$login" --accept-dns=false --timeout=60s; then
    echo "tvbox-join: couldn't join TV's tailnet (above is Tailscale's reason). Check the key, or ask Danny for a new one." >&2
    exit 1
fi

ids=$HOME/.passage/identities
if [ ! -s "$ids" ]; then
    mkdir -p "$HOME/.passage" && chmod 700 "$HOME/.passage"
    age-keygen -o "$ids.tmp" 2>/dev/null && chmod 600 "$ids.tmp" && mv "$ids.tmp" "$ids" ||
        { rm -f "$ids.tmp"; echo "tvbox-join: couldn't make your age key" >&2; exit 1; }
    made=yes
fi

echo
echo "You're on TV's tailnet. Send these three lines to Danny:"
echo
echo "login: $login"
me=$(tvbox-identity)
echo "syncthing: $(printf '%s' "$me" | jq -r .syncthing)"
echo "age: $(printf '%s' "$me" | jq -r .age)"
echo
if [ "${made:-}" = yes ]; then
    echo "Your secret key is new. Save a copy somewhere safe now, such as your"
    echo "password manager: tv export-key tv-age-key.txt, then store that file"
    echo "safely and delete it here."
fi
