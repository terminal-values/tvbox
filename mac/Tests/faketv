#!/bin/sh
# Stands in for tv in the app's tests. Logs each call's arguments to
# $FAKETV_DIR/calls.log, then answers SUBCOMMAND from $FAKETV_DIR/SUBCOMMAND.out
# (and exits with $FAKETV_DIR/SUBCOMMAND.exit, default 0). FAKETV_SLEEP=n
# sleeps first; FAKETV_JUNK=1 prints something that isn't JSON.
d=${FAKETV_DIR:?FAKETV_DIR is not set}
echo "$*" >> "$d/calls.log"
[ -n "${FAKETV_SLEEP:-}" ] && sleep "$FAKETV_SLEEP"
if [ -n "${FAKETV_JUNK:-}" ]; then echo "Error: something that is not JSON"; exit 0; fi
cmd=${1:-help}
[ -f "$d/$cmd.out" ] && cat "$d/$cmd.out"
[ -f "$d/$cmd.exit" ] && exit "$(cat "$d/$cmd.exit")"
exit 0
