#!/usr/bin/env python3
"""Stands in for container, docker or podman in tv's tests.

Appends each invocation's argv (as JSON, with the name it was called by
first) to $FAKE_LOG. Behaviour:
  FAKE_DOWN=1          the runtime's service isn't running
  FAKE_STATE=...       the box is running, stopped or absent (default absent)
  FAKE_RUN_FAILS=1     making the box fails (as when its port is taken)
  FAKE_EXEC_OUT=...    what exec prints
  FAKE_PULL_FAILS=1    pulling an image fails (offline)
  stats                answers in each runtime's own --format json shape
"""
import json
import os
import sys

name = os.path.basename(sys.argv[0])
args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps([name] + args) + "\n")

down = os.environ.get("FAKE_DOWN") == "1"
state = os.environ.get("FAKE_STATE", "absent")
verb = args[0] if args else ""

if verb in ("info",) or args[:2] == ["system", "status"]:
    sys.exit(1 if down else 0)
if down:
    print("Cannot connect to the runtime", file=sys.stderr)
    sys.exit(125)
if verb == "run" and os.environ.get("FAKE_RUN_FAILS") == "1":
    print("Error: bind: Address already in use", file=sys.stderr)
    sys.exit(1)
if (verb == "pull" or args[:2] == ["image", "pull"]) and os.environ.get("FAKE_PULL_FAILS") == "1":
    print("Error: could not reach the registry", file=sys.stderr)
    sys.exit(1)
if verb == "stats":
    if name == "container":
        # Cumulative CPU time: 30 ms more at each call, so 3% over a second.
        n_file = os.environ["FAKE_LOG"] + ".statscount"
        n = int(open(n_file).read()) if os.path.exists(n_file) else 0
        open(n_file, "w").write(str(n + 1))
        print(json.dumps([{"cpuUsageUsec": 178654071 + 30000 * n, "id": "tvbox",
                           "memoryLimitBytes": 1073741824, "memoryUsageBytes": 408944640,
                           "numProcesses": 34}]))
    elif name == "docker":
        print(json.dumps({"CPUPerc": "3.00%", "MemUsage": "390MiB / 1GiB", "Name": "tvbox"}))
    else:
        print(json.dumps([{"name": "tvbox", "cpu_percent": "3.00%",
                           "mem_usage": "408.9MB / 1.074GB"}]))
    sys.exit(0)
if verb == "exec" and "FAKE_EXEC_OUT" in os.environ:
    print(os.environ["FAKE_EXEC_OUT"])
    sys.exit(0)
if verb == "inspect":
    if state == "absent":
        print("no such container", file=sys.stderr)
        sys.exit(1)
    running = state == "running"
    if name == "container":
        print(json.dumps([{"status": "running" if running else "stopped"}]))
    else:
        print("true" if running else "false")
    sys.exit(0)
sys.exit(0)
